{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "package-name": "fern",
      "include-v-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "include/version.h"
        },
        {
          "type": "toml",
          "path": "compiler-rs/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "compiler-rs/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'fern-prototype')].version"
        },
        {
          "type": "toml",
          "path": "benchmarks/compiler-phases/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'fern-prototype')].version"
        }
      ]
    }
  }
}
