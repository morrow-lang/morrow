fn main():
    let captures = Regex.captures("b", "(a)?(b)")
    println(List.len(captures))
    println(List.get(captures, 0).2)
    println(List.get(captures, 1).0)
    println(List.get(captures, 1).1)
    println(List.get(captures, 1).2 == "")
    println(List.get(captures, 2).2)
    let trailing = Regex.captures("a", "(a)(b)?")
    println(List.len(trailing))
    println(List.get(trailing, 2).0)
    let empty = Regex.captures("b", "(a*)(b)")
    println(List.get(empty, 1).0)
    println(List.get(empty, 1).1)
