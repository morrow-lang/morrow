+#[test]
+fn fragment_boundary_preserves_alignment_and_ordered_finalizers_controls() {
+    use std::sync::{Arc, Mutex};
+    type Events = Arc<Mutex<Vec<(char, usize)>>>;
+    #[repr(align(64))]
+    struct Value {
+        events: Events,
+        address: usize,
+    }
+    impl Drop for Value {
+        fn drop(&mut self) {
+            self.events.lock().unwrap().push(('F', self.address));
+        }
+    }
+    struct Retention {
+        events: Events,
+        address: usize,
+    }
+    impl Drop for Retention {
+        fn drop(&mut self) {
+            self.events.lock().unwrap().push(('C', self.address));
+        }
+    }
+    unsafe fn release(pointer: *const ()) {
+        // SAFETY: exactly one Arc strong reference was consumed by Control::new.
+        unsafe {
+            drop(Arc::from_raw(pointer.cast::<Retention>()));
+        }
+    }
+    for count in [1, 2, 3, 64] {
+        for adopt in [false, true] {
+            let events: Events = Arc::new(Mutex::new(Vec::new()));
+            let sender_events = events.clone();
+            let (fragment, addresses) = std::thread::spawn(move || {
+                let mut fragment = super::Fragment::new();
+                let mut addresses = Vec::new();
+                for _ in 0..count {
+                    // SAFETY: Arc-backed event records own no collected pointers;
+                    // inert finalizers can run after sender thread destruction.
+                    unsafe {
+                        let value = fragment.managed(
+                            Value {
+                                events: sender_events.clone(),
+                                address: 0,
+                            },
+                            37,
+                        );
+                        assert_eq!(value as usize % 64, 0);
+                        (*value).address = value as usize;
+                        let retention = Arc::new(Retention {
+                            events: sender_events.clone(),
+                            address: value as usize,
+                        });
+                        let token = super::Control::new(Arc::into_raw(retention).cast(), release);
+                        fragment.retain_control(value.cast(), token);
+                        addresses.push(value as usize);
+                    }
+                }
+                (fragment, addresses)
+            })
+            .join()
+            .unwrap();
+            // Original Domain is gone; returned storage is the sole native owner.
+            let mut sorted = addresses.clone();
+            sorted.sort_unstable();
+            std::thread::spawn(move || {
+                if adopt {
+                    fragment.adopt();
+                    let roots = addresses;
+                    // SAFETY: addresses are stable and the Vec outlives this root.
+                    let root = unsafe { super::root_range(roots.as_ptr(), roots.len()) };
+                    // SAFETY: every live native root is registered above, or all have retired.
+                    unsafe {
+                        super::morrow_gc_collect_precise();
+                    }
+                    assert_eq!(super::stats().objects, count);
+                    assert_eq!(super::stats().bytes, count * (64 + 37));
+                    for &address in &roots {
+                        assert_eq!(unsafe { (*(address as *const Value)).address }, address);
+                    }
+                    drop(root);
+                    // SAFETY: every live native root is registered above, or all have retired.
+                    unsafe {
+                        super::morrow_gc_collect_precise();
+                    }
+                    assert_eq!(super::stats().bytes, 0);
+                    assert_eq!(super::stats().objects, 0);
+                } else {
+                    drop(fragment);
+                }
+            })
+            .join()
+            .unwrap();
+            let actual = events.lock().unwrap().clone();
+            let expected: Vec<_> = if adopt {
+                // Collector finalizes and releases each block before its successor.
+                sorted
+                    .iter()
+                    .flat_map(|&address| [('F', address), ('C', address)])
+                    .collect()
+            } else {
+                // Detached/Heap Drop finalizes all blocks, then drops all controls.
+                sorted
+                    .iter()
+                    .map(|&address| ('F', address))
+                    .chain(sorted.iter().map(|&address| ('C', address)))
+                    .collect()
+            };
+            assert_eq!(actual, expected, "count={count}, adopt={adopt}");
+        }
+    }
+}
