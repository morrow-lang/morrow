@@ -0,0 +1,54 @@
+//! Tiny graph copies avoid a temporary hash table; larger graphs retain it.
+use std::collections::HashMap;
+
+type Key = (i64, usize);
+type Entry = (Key, i64);
+const INLINE: usize = 2;
+
+pub(super) enum Memo {
+    Inline {
+        entries: [Entry; INLINE],
+        len: usize,
+    },
+    Overflow(HashMap<Key, i64>),
+}
+impl Default for Memo {
+    fn default() -> Self {
+        Self::Inline {
+            entries: [((0, 0), 0); INLINE],
+            len: 0,
+        }
+    }
+}
+impl Memo {
+    pub(super) fn get(&self, key: &Key) -> Option<&i64> {
+        match self {
+            Self::Inline { entries, len } => entries[..*len]
+                .iter()
+                .find_map(|(prior, value)| (prior == key).then_some(value)),
+            Self::Overflow(values) => values.get(key),
+        }
+    }
+    pub(super) fn insert(&mut self, key: Key, value: i64) {
+        match self {
+            Self::Inline { entries, len } => {
+                if let Some((_, prior)) =
+                    entries[..*len].iter_mut().find(|(prior, _)| *prior == key)
+                {
+                    *prior = value;
+                } else if *len < INLINE {
+                    entries[*len] = (key, value);
+                    *len += 1;
+                } else {
+                    let mut values = HashMap::with_capacity(INLINE + 1);
+                    values.extend(entries.iter().copied());
+                    values.insert(key, value);
+                    *self = Self::Overflow(values);
+                }
+            }
+            Self::Overflow(values) => {
+                values.insert(key, value);
+            }
+        }
+    }
+}
