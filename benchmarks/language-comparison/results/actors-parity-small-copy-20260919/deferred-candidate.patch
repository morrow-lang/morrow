+#[test]
+fn tiny_fragment_metadata_does_not_allocate() {
+    // Warm domain/accounting initialization outside the observed interval.
+    drop(super::Fragment::new());
+    let before = super::stats();
+    println!(
+        "metadata sizes: block={} heap={} accounting={} fragment={} prior_fragment={}",
+        std::mem::size_of::<super::Block>(),
+        std::mem::size_of::<super::Heap>(),
+        std::mem::size_of::<super::ControlAllocation>(),
+        std::mem::size_of::<super::Fragment>(),
+        std::mem::size_of::<super::Heap>() + std::mem::size_of::<super::ControlAllocation>()
+    );
+    let mut tiny_metadata = 0;
+    for length in [0, 1, 2, 3, 64] {
+        let mut addresses = [0usize; 64];
+        let (fragment, count) = measure(|| {
+            let mut fragment = super::Fragment::new();
+            for (i, address) in addresses[..length].iter_mut().enumerate() {
+                let pointer = fragment.allocate(16, true).cast::<u64>();
+                // SAFETY: each block provides two initialized aligned u64 words.
+                unsafe {
+                    pointer.write(i as u64);
+                    pointer.add(1).write(u64::MAX - i as u64);
+                }
+                *address = pointer as usize;
+            }
+            fragment
+        });
+        println!("fragment blocks={length} {count:?}");
+        assert_eq!(count.zeroed, length);
+        for (i, &address) in addresses[..length].iter().enumerate() {
+            // SAFETY: the still-owned fragment keeps these exact addresses live.
+            unsafe {
+                assert_eq!(*(address as *const u64), i as u64);
+                assert_eq!(*((address as *const u64).add(1)), u64::MAX - i as u64);
+            }
+        }
+        drop(fragment);
+        assert_eq!(super::stats().bytes, before.bytes);
+        assert_eq!(super::stats().objects, before.objects);
+        if length <= 2 {
+            tiny_metadata += count.plain;
+        }
+    }
+    assert_eq!(
+        tiny_metadata, 0,
+        "tiny detached payload needs no temporary metadata allocation"
+    );
+}
