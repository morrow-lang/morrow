+            // finalizers are inert and may run after the creator's Domain exits.
+            unsafe {
+                block.destroy(address);
+            }
+        };
+        match &self.blocks {
+            Blocks::Inline(blocks) => {
+                for (address, block) in blocks.iter().flatten() {
+                    destroy(*address, block);
+                }
+            }
+            Blocks::Tree(blocks) => {
+                for (&address, block) in blocks {
+                    destroy(address, block);
+                }
+            }
+        }
+        // Field destruction releases retained controls after all native blocks,
+        // matching Heap::drop, then releases the creator's physical accounting.
+    }
+}
