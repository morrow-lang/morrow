+//! Count real copy allocations and preserve graph identity across tiny/fallback paths.
+use super::*;
+use crate::memory::fragment_probe::measure;
+
+fn ty(kind: i64, children: &[*const Type]) -> Type {
+    Type {
+        kind,
+        count: children.len() as i64,
+        children: children.as_ptr(),
+        arities: null(),
+    }
+}
+#[test]
+fn tiny_copy_requires_no_temporary_metadata_allocation() {
+    let scalar = ty(0, &[]);
+    let scalar_fields = [&scalar as *const Type];
+    let answer = ty(3, &scalar_fields);
+    let string = ty(1, &[]);
+    let string_fields = [&string as *const Type];
+    let owned = ty(3, &string_fields);
+    let scalar_value = [0, i64::MIN];
+    let owned_value = [0, c"owned".as_ptr() as i64];
+    drop(memory::Fragment::new());
+    let mut metadata = 0;
+    for (descriptor, source, blocks) in [
+        (&answer, scalar_value.as_ptr(), 1),
+        (&owned, owned_value.as_ptr(), 2),
+    ] {
+        // SAFETY: literal immutable descriptors/values live through synchronous copy.
+        unsafe {
+            assert!(cost::value(null_mut(), descriptor, source as i64).is_some());
+            let (fragment, counts) =
+                measure(|| value_fragment(null_mut(), descriptor, source as i64));
+            println!("tiny memo blocks={blocks} {counts:?}");
+            metadata += counts.plain;
+            assert_eq!(counts.zeroed, blocks);
+            let target = fragment.value as *const i64;
+            assert_ne!(target, source);
+            assert_eq!(*target, 0);
+            if blocks == 1 {
+                assert_eq!(*target.add(1), i64::MIN);
+            } else {
+                assert_eq!(
+                    std::ffi::CStr::from_ptr(*target.add(1) as *const _),
+                    c"owned"
+                );
+                assert_ne!(*target.add(1), owned_value[1]);
+            }
+            drop(fragment);
+        }
+    }
+    assert_eq!(
+        metadata, 0,
+        "tiny graph copy and detached storage need no temporary metadata allocation"
+    );
+}
+
+#[test]
+fn memo_keys_preserve_full_width_source_descriptor_and_frame_sentinel() {
+    let mut copy = Copy::fragment(null_mut());
+    assert_eq!(copy.seen.get(&(0, 0)), None);
+    println!(
+        "memo bytes={} prior_hashmap_bytes={} fragment_copy_bytes={}",
+        std::mem::size_of::<memo::Memo>(),
+        std::mem::size_of::<HashMap<(i64, usize), i64>>(),
+        std::mem::size_of::<FragmentCopy>()
+    );
+    for descriptor in [0, usize::MAX, 1, 2, 3, 4, 5, 6] {
+        let value = i64::MIN.wrapping_add(descriptor as i64);
+        copy.seen.insert((i64::MAX, descriptor), value);
+        for prior in [0, usize::MAX, 1, 2, 3, 4, 5, 6]
+            .into_iter()
+            .take_while(|&prior| prior != descriptor)
+        {
+            assert_eq!(
+                copy.seen.get(&(i64::MAX, prior)),
+                Some(&i64::MIN.wrapping_add(prior as i64))
+            );
+        }
+        assert_eq!(copy.seen.get(&(i64::MAX, descriptor)), Some(&value));
+    }
+    copy.seen.insert((i64::MAX, 0), i64::MAX);
+    assert_eq!(copy.seen.get(&(i64::MAX, 0)), Some(&i64::MAX));
+    assert_eq!(copy.seen.get(&(i64::MIN, 0)), None);
+    assert_eq!(copy.seen.get(&(i64::MAX, 42)), None);
+}
+
+#[test]
+fn descriptor_sensitive_dag_sharing_survives_spill_and_adoption() {
+    unsafe {
+        let scalar = ty(0, &[]);
+        let children = [&scalar as *const Type, &scalar];
+        let first = ty(3, &children);
+        let second = ty(3, &children);
+        let fields = [&first as *const Type, &second, &first];
+        let outer = ty(3, &fields);
+        let leaf = [0, i64::MIN, i64::MAX];
+        let source = [
+            0,
+            leaf.as_ptr() as i64,
+            leaf.as_ptr() as i64,
+            leaf.as_ptr() as i64,
+        ];
+        assert!(cost::value(null_mut(), &outer, source.as_ptr() as i64).is_some());
+        let fragment = value_fragment(null_mut(), &outer, source.as_ptr() as i64);
+        let pointer = fragment.adopt() as *const i64;
+        let root_word = pointer as usize;
+        let root = memory::root_range(&root_word, 1);
+        memory::morrow_gc_collect_precise();
+        assert_eq!(*pointer.add(1), *pointer.add(3));
+        assert_ne!(*pointer.add(1), *pointer.add(2));
+        for offset in [1, 2] {
+            assert_eq!(
+                std::slice::from_raw_parts(*pointer.add(offset) as *const i64, 3),
+                leaf
+            );
+        }
+        drop(root);
+        memory::morrow_gc_collect_precise();
+    }
+}
+
+#[test]
+fn cyclic_source_remains_rejected_before_any_copy_allocation() {
+    let mut recursive = ty(3, &[]);
+    let children = [&recursive as *const Type];
+    recursive.children = children.as_ptr();
+    recursive.count = 1;
+    let mut source = [0i64; 2];
+    source[1] = source.as_ptr() as i64;
+    let (accepted, counts) = measure(|| unsafe {
+        cost::value(null_mut(), &recursive, source.as_ptr() as i64).is_some()
+    });
+    assert!(!accepted);
+    assert_eq!(counts.plain + counts.zeroed, 0);
+}
+
+#[test]
+fn wide_heap_copy_keeps_every_fallback_value_rooted_through_collection() {
+    unsafe {
+        let string = ty(1, &[]);
+        let fields = [&string as *const Type; 64];
+        let outer = ty(3, &fields);
+        let texts: Vec<_> = (0..64)
+            .map(|index| std::ffi::CString::new(format!("word{index}")).unwrap())
+            .collect();
+        let mut source = vec![0];
+        source.extend(texts.iter().map(|text| text.as_ptr() as i64));
+        assert!(cost::value(null_mut(), &outer, source.as_ptr() as i64).is_some());
+        let copied = value(null_mut(), &outer, source.as_ptr() as i64);
+        memory::morrow_gc_collect_precise();
+        for (index, text) in texts.iter().enumerate() {
+            let pointer = *((copied.value as *const i64).add(index + 1)) as *const std::ffi::c_char;
+            assert_ne!(pointer, text.as_ptr());
+            assert_eq!(std::ffi::CStr::from_ptr(pointer), text.as_c_str());
+        }
+        drop(copied);
+        memory::morrow_gc_collect_precise();
+        assert_eq!(memory::stats().objects, 0);
+    }
+}
+
+#[test]
+fn memo_replaces_inline_keys_without_spilling_including_all_zero_key() {
+    let mut copy = Copy::fragment(null_mut());
+    assert_eq!(copy.seen.get(&(0, 0)), None);
+    let (_, counts) = measure(|| {
+        copy.seen.insert((0, 0), i64::MIN);
+        copy.seen.insert((i64::MIN, usize::MAX), i64::MAX);
+        assert_eq!(copy.seen.get(&(0, 0)), Some(&i64::MIN));
+        assert_eq!(copy.seen.get(&(i64::MIN, usize::MAX)), Some(&i64::MAX));
+        for value in [0, i64::MAX, i64::MIN] {
+            copy.seen.insert((0, 0), value);
+            copy.seen.insert((i64::MIN, usize::MAX), !value);
+            assert_eq!(copy.seen.get(&(0, 0)), Some(&value));
+            assert_eq!(copy.seen.get(&(i64::MIN, usize::MAX)), Some(&!value));
+        }
+    });
+    assert_eq!(
+        counts.plain + counts.zeroed,
+        0,
+        "replacement of either inline key must not spill"
+    );
+    // A third distinct key may spill, but cannot erase the all-zero key.
+    copy.seen.insert((i64::MAX, 0), 42);
+    assert_eq!(copy.seen.get(&(0, 0)), Some(&i64::MIN));
+    assert_eq!(copy.seen.get(&(i64::MIN, usize::MAX)), Some(&i64::MAX));
+    assert_eq!(copy.seen.get(&(i64::MAX, 0)), Some(&42));
+}
