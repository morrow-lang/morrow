+//! Independent allocator probe: native payloads use zeroed allocation, metadata does not.
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::cell::Cell;
+
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct Counts {
+    pub plain: usize,
+    pub zeroed: usize,
+    pub plain_bytes: usize,
+    pub zeroed_bytes: usize,
+}
+thread_local! {
+    static ACTIVE: Cell<Option<Counts>> = const { Cell::new(None) };
+}
+struct Counter;
+fn record(layout: Layout, zeroed: bool) {
+    let _ = ACTIVE.try_with(|active| {
+        if let Some(mut count) = active.get() {
+            if zeroed {
+                count.zeroed += 1;
+                count.zeroed_bytes += layout.size();
+            } else {
+                count.plain += 1;
+                count.plain_bytes += layout.size();
+            }
+            active.set(Some(count));
+        }
+    });
+}
+// SAFETY: forwarding preserves all allocator contracts; counters allocate nothing.
+unsafe impl GlobalAlloc for Counter {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        record(layout, false);
+        unsafe { System.alloc(layout) }
+    }
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        record(layout, true);
+        unsafe { System.alloc_zeroed(layout) }
+    }
+    unsafe fn dealloc(&self, pointer: *mut u8, layout: Layout) {
+        unsafe { System.dealloc(pointer, layout) }
+    }
+    unsafe fn realloc(&self, pointer: *mut u8, layout: Layout, size: usize) -> *mut u8 {
+        record(
+            Layout::from_size_align(size, layout.align()).unwrap(),
+            false,
+        );
+        unsafe { System.realloc(pointer, layout, size) }
+    }
+}
+#[global_allocator]
+static ALLOCATOR: Counter = Counter;
+pub(crate) fn measure<T>(operation: impl FnOnce() -> T) -> (T, Counts) {
+    ACTIVE.with(|active| assert!(active.replace(Some(Counts::default())).is_none()));
+    let value = operation();
+    let count = ACTIVE.with(|active| active.replace(None).unwrap());
+    (value, count)
+}
