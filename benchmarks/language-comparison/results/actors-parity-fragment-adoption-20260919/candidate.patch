+/// Move allocation metadata without changing native addresses or value ownership.
+fn adopt_map<K: Ord, V>(target: &mut BTreeMap<K, V>, source: &mut BTreeMap<K, V>) {
+    if source.is_empty() {
+        return;
+    }
+    if target.is_empty() {
+        std::mem::swap(target, source);
+        return;
+    }
+    // append's merge cursor can walk the whole target between separated source
+    // keys. Prefer independent searches when their estimated work is smaller:
+    // two binary-search depths per insertion versus one target traversal. This
+    // division avoids overflow and bounds sparse work by the consumed source;
+    // similarly sized maps retain the standard library's dense merge.
+    let search_work = 2 * (usize::BITS - target.len().leading_zeros()) as usize;
+    if source.len() <= target.len() / search_work {
+        for (key, value) in std::mem::take(source) {
+            target.insert(key, value);
+        }
+    } else {
+        target.append(source);
+    }
+}
