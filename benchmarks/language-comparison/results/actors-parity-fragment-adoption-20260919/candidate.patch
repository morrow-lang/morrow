@@ -0,0 +1,137 @@
+use super::adopt_map;
+use std::cell::Cell;
+use std::cmp::Ordering;
+use std::collections::BTreeMap;
+use std::rc::Rc;
+
+thread_local! { static COMPARISONS: Cell<usize> = const { Cell::new(0) }; }
+
+#[derive(Clone)]
+struct Key {
+    value: usize,
+}
+impl PartialEq for Key {
+    fn eq(&self, other: &Self) -> bool {
+        self.cmp(other) == Ordering::Equal
+    }
+}
+impl Eq for Key {}
+impl PartialOrd for Key {
+    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
+        Some(self.cmp(other))
+    }
+}
+impl Ord for Key {
+    fn cmp(&self, other: &Self) -> Ordering {
+        COMPARISONS.with(|count| count.set(count.get() + 1));
+        self.value.cmp(&other.value)
+    }
+}
+struct Value {
+    value: usize,
+    drops: Rc<Cell<usize>>,
+}
+impl Drop for Value {
+    fn drop(&mut self) {
+        self.drops.set(self.drops.get() + 1);
+    }
+}
+
+#[test]
+fn tiny_fragment_does_not_scan_unrelated_target_allocations() {
+    let drops = Rc::new(Cell::new(0));
+    let entry = |value| {
+        (
+            Key { value },
+            Value {
+                value,
+                drops: Rc::clone(&drops),
+            },
+        )
+    };
+    let mut target: BTreeMap<_, _> = (1..=32768).map(entry).collect();
+    let mut source: BTreeMap<_, _> = [0, 32769].into_iter().map(entry).collect();
+    COMPARISONS.with(|count| count.set(0));
+    adopt_map(&mut target, &mut source);
+    let work = COMPARISONS.with(|count| count.get());
+    assert!(source.is_empty());
+    assert_eq!(target.len(), 32770);
+    assert_eq!(
+        drops.get(),
+        0,
+        "metadata adoption cannot finalize a live block"
+    );
+    for (expected, (key, value)) in target.iter().enumerate() {
+        assert_eq!((key.value, value.value), (expected, expected));
+    }
+    drop(source);
+    assert_eq!(drops.get(), 0);
+    drop(target);
+    assert_eq!(
+        drops.get(),
+        32770,
+        "every owned block must drop exactly once"
+    );
+    println!("sparse adoption comparisons: {work}");
+    assert!(
+        work <= 256,
+        "adopting two separated keys compared {work} keys; it must not walk the unrelated target"
+    );
+}
+
+#[test]
+fn empty_sparse_and_dense_adoption_preserve_replacement_and_drop_semantics() {
+    for (target_len, source_keys) in [
+        (0, vec![1, 2]),
+        (2, vec![]),
+        (32768, vec![1, 32768]),
+        (4, vec![0, 1, 3, 5, 7]),
+    ] {
+        let old_drops = Rc::new(Cell::new(0));
+        let new_drops = Rc::new(Cell::new(0));
+        let mut target: BTreeMap<_, _> = (0..target_len)
+            .map(|value| {
+                (
+                    Key { value },
+                    Value {
+                        value,
+                        drops: Rc::clone(&old_drops),
+                    },
+                )
+            })
+            .collect();
+        let mut source: BTreeMap<_, _> = source_keys
+            .iter()
+            .copied()
+            .map(|value| {
+                (
+                    Key { value },
+                    Value {
+                        value: value + 100000,
+                        drops: Rc::clone(&new_drops),
+                    },
+                )
+            })
+            .collect();
+        let replaced = source_keys.iter().filter(|key| **key < target_len).count();
+        adopt_map(&mut target, &mut source);
+        assert!(source.is_empty());
+        assert_eq!(target.len(), target_len + source_keys.len() - replaced);
+        assert_eq!(old_drops.get(), replaced);
+        assert_eq!(new_drops.get(), 0);
+        for (key, value) in &target {
+            let expected = key.value
+                + if source_keys.contains(&key.value) {
+                    100000
+                } else {
+                    0
+                };
+            assert_eq!(value.value, expected);
+        }
+        drop(source);
+        assert_eq!(new_drops.get(), 0);
+        drop(target);
+        assert_eq!(old_drops.get(), target_len);
+        assert_eq!(new_drops.get(), source_keys.len());
+    }
+}
