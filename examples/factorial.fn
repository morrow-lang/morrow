@moduledoc """
Factorial calculation using recursion.

Demonstrates recursive functions, conditionals and executable documentation
examples. Run `fern test --doc examples/factorial.fn` to check the examples
below, or `fern doc examples --site docs-site` to browse them.
"""

@doc """
Compute `n!` recursively.

Negative inputs return `1` because the recursion stops at the base case.

# Examples

```fern
factorial(0)  # => 1
factorial(5)  # => 120
```
"""
fn factorial(n: Int) -> Int:
    if n <= 1:
        1
    else:
        n * factorial(n - 1)

fn main():
    # Calculate factorials
    println(factorial(0))
    println(factorial(1))
    println(factorial(5))
    println(factorial(10))
