fn test(value: Int, limit: Int) -> Bool:
    println(limit)
    value < limit
fn choose(value: Int) -> Int:
    match:
        test(value: value, limit: 0) -> return -1
        test(value: value, limit: 10) -> 1
        _ -> 2
fn main():
    println(choose(-5))
    println(choose(5))
    println(choose(50))
