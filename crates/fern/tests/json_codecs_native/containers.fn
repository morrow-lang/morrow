fn main() -> Result(Unit,json.Error):
    let values = json.decode("[9007199254740993,-7]",List(Int))?
    println(List.head(values))
    let (number,text) = json.decode("[2.5,\"Fern\"]",(Float,String))?
    println(number)
    println(text)
    let map = json.decode("\{\"second\":[2,3],\"first\":[]\}",Map(String,List(Int)))?
    println(json.encode(map)?)
    let present = json.decode("true",Option(Bool))?
    println(Option.unwrap_or(present,false))
    println(json.encode(())?)
    Ok(())
