type Chain(a) derive(Json):
    End
    Link(a,Chain(a))
fn write(value):json.encode(value)
fn main() -> Result(Unit,json.Error):
    let chain:Chain(Int)=Link(1,Link(2,End))
    println(write(chain)?)
    let text=json.decode("\{\"tag\":\"Link\",\"fields\":[\"Fern\",\{\"tag\":\"End\",\"fields\":[]\}]\}",Chain(String))?
    println(write(Some(text))?)
    Ok(())
