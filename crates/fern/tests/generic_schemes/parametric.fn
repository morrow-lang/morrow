type Box(a):
    value: a
fn wrap(value: a) -> Box(a): Box(value)
fn unbox(box: Box(a)) -> a: box.value
fn swap(pair: (a, b)) -> (b, a): (pair.1, pair.0)
fn compose(first: (b) -> c, second: (a) -> b) -> (a) -> c:
    (value) -> first(second(value))
fn number(value: Int) -> String: "n={value}"
fn bump(value: Int) -> Int: value + 1
fn main():
    println(unbox(wrap(9223372036854775807)))
    println(unbox(wrap("Fern")))
    println(swap((7, "second")).0)
    println(compose(number, bump)(41))
