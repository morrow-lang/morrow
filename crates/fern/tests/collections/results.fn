fn fetch(success: Bool) -> Result(String, String):
    if success: Ok("payload") else: Err("unavailable")

fn describe(result: Result(String, String)) -> String:
    match result:
        Ok(value) -> String.concat("ok: ", value)
        Err(error) -> String.concat("error: ", error)

fn main():
    println(describe(fetch(success: true)))
    println(describe(fetch(success: false)))
    println(Result.is_ok(fetch(success: true)))
    println(Result.is_err(fetch(success: false)))
    println(Result.unwrap_or(fetch(success: false), "fallback"))
