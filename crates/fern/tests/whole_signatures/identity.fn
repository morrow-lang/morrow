fn identity(value) -> value
fn pair(left, right) -> (left, right)
fn main():
    println(identity(42))
    println(identity("Fern"))
    println(identity(true))
    let (name, number) = pair("answer", 42)
    println(name)
    println(number)
    let callback: (String) -> String = identity
    println(callback("saved"))
