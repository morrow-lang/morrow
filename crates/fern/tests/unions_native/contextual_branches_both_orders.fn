fn describe(value: Int | String) -> String:
    match value:
        n: Int -> "number:{n}"
        s: String -> "string:{s}"
fn first(flag: Bool) -> Int | String:
    if flag: 7 else: "fern"
fn second(flag: Bool) -> Int | String:
    if flag: "fern" else: 7
fn main():
    println(describe(first(flag: true)))
    println(describe(second(flag: true)))
