type Holder:
    payload: Int | String
fn make(flag: Bool) -> Result(Int | String, Bool):
    Ok(if flag: 4294967296 else: "fern")
fn print_value(x: Int | String) -> Unit:
    match x:
        n: Int -> println(n)
        s: String -> println(s)
fn main():
    let record = Holder("record")
    print_value(record.payload)
    let other = %{record | payload: 4294967297}
    print_value(other.payload)
    match make(flag: true):
        Ok(x) -> print_value(x)
        Err(b) -> println(b)
    match make(flag: false):
        Ok(x) -> print_value(x)
        Err(b) -> println(b)
