type Box(a):
    value: a
fn consume(x: Box(a)) -> Unit: println("consume")
fn mark(value: Int) -> Int:
    println("mark")
    value
fn read(x):
    let value = x.value
    consume(x)
    value
fn change(x):
    let changed = %{x | value: mark(42)}
    consume(x)
    changed
fn main():
    println(read(Box("Fern")))
    println(read(Box(7)))
    println(change(Box(1)).value)
