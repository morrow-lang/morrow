type Actions:
    enumerate: () -> Int
fn consume(value: Actions) -> Unit: println("action")
fn invoke(value):
    let answer = value.enumerate()
    consume(value)
    answer
fn pairs(items):
    let values = items.enumerate()
    List.len(items)
    values
fn main():
    println(invoke(Actions(() -> 42)))
    println(List.head(pairs(["Fern"])).1)
