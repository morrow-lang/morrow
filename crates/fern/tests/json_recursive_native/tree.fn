type Tree(a) derive(Json):
    value: a
    children: List(Tree(a))

fn main() -> Result(Unit, json.Error):
    let first: Tree(Int) = Tree(9223372036854775807, [Tree(-9223372036854775808, [])])
    println(json.encode(first)?)
    let second = json.decode("\{\"value\":\"Fern\",\"children\":[\{\"value\":\"🌿\",\"children\":[]\}]\}", Tree(String))?
    println(json.encode(second)?)
    Ok(())
