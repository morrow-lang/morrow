newtype Flag = Flag(Bool)
newtype Other = Other(Bool)
fn first(left: a, right: b) -> a: left
fn same(left: a, right: a) -> Bool: left == right
fn wrapped(left: Flag, right: Other) -> Bool: left.0
fn add(left: Int, right: Int) -> Int: left + right
fn main():
    println(first(true, false))
    println(same(right: 1.25, left: 1.25))
    println(wrapped(Flag(true), Other(false)))
    let sum = add
    println(sum(1, 2))
    println(String.slice("fern", 1, 3))
