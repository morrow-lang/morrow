# Native object ABI: objects stay opaque across functions and list storage.
fn panel_text(panel: Tui.Panel) -> String:
    Tui.Panel.render(panel)
fn main():
    let panel = Tui.Panel.new("hello")
    let panel = Tui.Panel.title(panel, "title")
    let panel = Tui.Panel.subtitle(panel, "subtitle")
    let panel = Tui.Panel.border(panel, "ascii")
    let panel = Tui.Panel.width(panel, 20)
    let panel = Tui.Panel.padding(panel, 1)
    let panel = Tui.Panel.border_color(panel, "cyan")
    println(String.contains(panel_text(List.head([panel])), "hello"))
    println(String.contains(panel_text(panel), "title"))
    let table = Tui.Table.new()
    let table = Tui.Table.title(table, "people")
    let table = Tui.Table.add_column(table, "name")
    let table = Tui.Table.add_row(table, ["Fern 🌿"])
    let table = Tui.Table.border(table, "double")
    let table = Tui.Table.show_header(table, 0)
    println(String.contains(Tui.Table.render(table), "╔"))
    println(String.contains(Tui.Table.render(table), "Fern 🌿"))
    let table = Tui.Table.border(table, "unknown")
    println(String.contains(Tui.Table.render(table), "╔"))
    let root = Tui.Tree.new("root")
    let tree = Tui.Tree.add(root, Tui.Tree.new("leaf"))
    println(String.contains(Tui.Tree.render(tree), "leaf"))
    println(String.contains(Tui.Tree.render(root), "leaf"))
    let progress = Tui.Progress.new(4294967296)
    let progress = Tui.Progress.description(progress, "work")
    let progress = Tui.Progress.width(progress, 4)
    let progress = Tui.Progress.set(progress, 2147483648)
    println(Tui.Progress.render(progress))
    let progress = Tui.Progress.advance(Tui.Progress.set(progress, 4294967295))
    println(Tui.Progress.render(progress))
    let spinner = Tui.Spinner.new()
    let spinner = Tui.Spinner.message(spinner, "wait")
    let spinner = Tui.Spinner.style(spinner, "line")
    println(Tui.Spinner.render(spinner))
    println(Tui.Spinner.render(Tui.Spinner.tick(spinner)))
