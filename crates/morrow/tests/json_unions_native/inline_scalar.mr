fn main()->Result(Unit,json.Error):
    let number=("9007199254740993" |> json.decode(Int | String))?
    println(json.encode(number)?)
    let word=json.decode("\"🌿\"",Int | String)?
    println(json.encode(word)?)
    let bad=json.decode("true",Int | String)
    match bad:
        Ok(_) -> println("wrong")
        Err(error) -> println(json.error_code(error))
    Ok(())
