fn main():
    let empty: Map(String, Int) = Map.new()
    println(Map.is_empty(empty))
    println(Map.len(empty))
    println(Option.is_none(Map.get(empty, "absent")))
    println(Map.len(Map.delete(empty, "absent")))
    println(List.len(Map.keys(empty)))
    println(List.len(Map.values(empty)))
    let original = %{"a": 1, "b": 2, "a": 3}
    println(Map.len(original))
    println(Option.unwrap_or(Map.get(original, "a"), 0))
    println(Map.contains(original, "b"))
    println(Map.contains(original, "absent"))
    let updated = Map.put(original, "a", 9)
    println(Option.unwrap_or(Map.get(original, "a"), 0))
    println(Option.unwrap_or(Map.get(updated, "a"), 0))
    println(List.get(Map.keys(updated), 0))
    println(List.get(Map.keys(updated), 1))
    let deleted = Map.delete(updated, "a")
    println(Map.len(updated))
    println(Map.len(deleted))
    println(Option.is_none(Map.get(deleted, "a")))
    let reinserted = Map.put(deleted, "a", 11)
    println(List.get(Map.keys(reinserted), 0))
    println(List.get(Map.keys(reinserted), 1))
    println(List.get(Map.values(reinserted), 0))
    println(List.get(Map.values(reinserted), 1))
    println(Map.is_empty(Map.delete(%{1: 2}, 1)))
