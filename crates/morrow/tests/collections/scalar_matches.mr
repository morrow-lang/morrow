fn int_name(number: Int) -> String:
    match number:
        -2 -> "negative"
        0 -> "zero"
        _ -> "other"

fn string_name(word: String) -> String:
    match word:
        "Morrow" -> "language"
        name -> String.concat("other: ", name)

fn main():
    println(int_name(-2))
    println(int_name(10))
    println(string_name(String.concat("Mor", "row")))
    println(string_name("tree"))
    match true:
        true -> println("yes")
        false -> println("no")
