fn work(early: Bool) -> Int:
    let snapshot = 1
    defer println(snapshot)
    let snapshot = 2
    defer println(snapshot)
    if early:
        defer println("conditional")
        println("body")
    println("after block")
    return 7 if early
    9
fn main():
    println(work(early: true))
    println(work(early: false))
