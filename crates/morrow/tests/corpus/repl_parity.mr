fn main():
    println(String.to_upper("straße élève az"))
    println(str_to_lower("ÄBC İ Z"))
    println(String.trim(" \t x \r\n"))
    println(String.trim_start(" \tx \n"))
    println(String.trim_end(" x \r\n"))
    println(String.join(String.split("abc", ""), "|"))
    println(List.len(String.split("", "")))
    println(List.len(String.split("", ",")))
    println(String.join(String.split(",a,,", ","), "|"))
    println(String.join(String.lines("a\r\nb\rc\n"), "|"))
    println(List.len(String.lines("")))
    println(List.len(String.lines("\n\n")))
    println(String.join([], ","))
    println(Option.unwrap_or(String.char_at("é", 0), -1))
    println(Option.unwrap_or(String.char_at("é", 1), -1))
    println(Option.unwrap_or(String.char_at("a", -1), -1))
    println(Option.unwrap_or(String.index_of("éx", "x"), -1))
    println(Option.unwrap_or(String.index_of("x", ""), -1))
    println(Option.is_none(String.index_of("x", "z")))
    println(str_slice("abcdef", -5, 3))
    println(String.slice("abc", 10, 2))
    println(String.slice("éx", 0, 2))
    println(String.replace("aaaa", "aa", "b"))
    println(String.replace("abc", "", "x"))
    println(str_repeat("ab", 3))
    println(String.repeat("ab", -1))
