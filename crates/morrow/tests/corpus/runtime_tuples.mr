fn main():
    let executed = System.exec("/usr/bin/printf stdout; /usr/bin/printf stderr >&2; exit 7")
    println(executed.0)
    println(executed.1)
    println(executed.2)
    let arguments = System.exec_args(["/usr/bin/printf", "%s", "literal ' ; $(echo forbidden) 🌿"])
    println(arguments.0)
    println(arguments.1)
    println(arguments.2 == "")
    let empty_arguments: List(String) = []
    let missing_command = System.exec_args(empty_arguments)
    println(missing_command.0)
    println(missing_command.2)
    let found = Option.unwrap_or(Regex.find("éabc123", "[a-z]+"), (-1, -1, "missing"))
    println(found.0)
    println(found.1)
    println(found.2)
    println(Option.is_none(Regex.find("abc", "[")))
    println(Option.is_none(Regex.find("abc", "xyz")))
    let zero = Option.unwrap_or(Regex.find("abc", "^"), (-1, -1, "missing"))
    println(zero.0)
    println(zero.1)
    println(zero.2 == "")
    let captures = Regex.captures("abc123", "([a-z]+)([0-9]+)")
    println(List.len(captures))
    println(List.get(captures, 0).2)
    println(List.get(captures, 1).2)
    println(List.get(captures, 2).2)
    println(List.get(captures, 2).0)
    println(List.get(captures, 2).1)
    println(List.len(Regex.captures("abc", "[")))
    println(List.len(Regex.captures("abc", "xyz")))
    let (cols, rows) = Tui.Term.size()
    println(cols)
    println(rows)
