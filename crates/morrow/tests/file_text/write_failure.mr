fn file_int(result: Result(Int, Int)) -> Int:
    match result:
        Ok(value) -> value
        Err(code) -> -code
fn status(result: Result(Int, Int)) -> Int:
    match result:
        Ok(n) -> n
        Err(code) -> -code
fn main():
    let path = System.arg(1)
    println(status(File.write(path, "lost")))
    println(file_int(File.size(path)))
    println(status(File.append(path, "lost")))
