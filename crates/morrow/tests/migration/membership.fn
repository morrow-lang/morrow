fn item() -> Int:
    println(1)
    4294967297
fn items() -> List(Int):
    println(2)
    [4294967297, 5]
fn member(item: a, items: List(a)) -> Bool:
    item in items
fn main():
    println(item() in items())
    println(1 in [])
    println("🌿" in ["morrow", "🌿"])
    println(false in [true])
    println(-0.0 in [0.0])
    println((0.0 / 0.0) in [0.0 / 0.0])
    println(1 + 1 in [2] and 3 in [3])
    println(member("morrow", ["morrow"]))
