newtype Amount = Amount(Float)
newtype Id = Id(Int)
fn count(n: Int, value: Amount) -> Amount:
    if n == 0: value else: count(n - 1, Amount(value.0 + 0.5))
fn make() -> Id:
    println("once")
    Id(42)
fn returned() -> Id:
    defer println("done")
    Id(if true: return Id(7) else: 1)
fn main():
    println(count(100000, Amount(0.0)).0)
    println(make().0)
    println(returned().0)
