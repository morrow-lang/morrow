#!/usr/bin/env bash
# Publish the Rust compiler only after its complete native component set exists.
set -euo pipefail
[[ $# == 1 ]] || { echo 'expected debug or release mode' >&2; exit 2; }
case "$1" in
  debug) flags=() ;;
  release) flags=(--release) ;;
  *) echo "unknown compiler build mode: $1" >&2; exit 2 ;;
esac
for component in fern-c fern-qbe fern-test-supervisor; do
  [[ -f "bin/$component" && -s "bin/$component" && -x "bin/$component" ]] || { echo "missing executable native component: $component" >&2; exit 1; }
done
[[ -f bin/libfern_runtime.a && -s bin/libfern_runtime.a ]] || { echo 'missing native component: libfern_runtime.a' >&2; exit 1; }
# mv treats directory destinations as containers; publication requires the exact sibling path.
for destination in fern fern-rs fern-package.json; do
  [[ ! -d "bin/$destination" ]] || {
    echo "invalid publication destination: bin/$destination is a directory" >&2; exit 1;
  }
done
target="${CARGO_TARGET_DIR:-compiler-rs/target}"
# An explicit host target overrides .cargo/config.toml and CARGO_BUILD_TARGET alike.
# The selected executable must come from this invocation's artifact event, not a stale guessed path.
host=$(rustc -vV | sed -n 's/^host: //p')
[[ -n "$host" && "$host" != *$'\n'* ]] || { echo 'could not determine native Rust target' >&2; exit 1; }
stage=$(mktemp -d bin/.fern-publish.XXXXXX)
trap 'rm -rf -- "$stage"' EXIT
cargo build --locked --manifest-path compiler-rs/Cargo.toml --bin fern-rs \
  --target-dir "$target" --target "$host" --message-format=json-render-diagnostics \
  ${flags[@]+"${flags[@]}"} > "$stage/artifacts.jsonl"
artifact=$(python3 - "$stage/artifacts.jsonl" <<'PYTHON'
import json
import os
from pathlib import Path
import sys

artifacts = []
for line in Path(sys.argv[1]).read_text().splitlines():
    event = json.loads(line)
    target = event.get("target", {})
    if (event.get("reason") == "compiler-artifact" and target.get("name") == "fern-rs"
            and target.get("kind") == ["bin"] and event.get("executable")):
        artifacts.append(Path(event["executable"]))
if len(artifacts) != 1:
    sys.exit("expected exactly one current fern-rs Cargo executable artifact")
artifact = artifacts[0]
if not artifact.is_file() or artifact.stat().st_size == 0 or not os.access(artifact, os.X_OK):
    sys.exit("Cargo fern-rs artifact must be a regular nonempty executable")
print(artifact)
PYTHON
)
install -m 755 "$artifact" "$stage/fern-rs"
install -m 755 "$artifact" "$stage/fern"
printf '%s\n' '{"format":1,"compiler":"rust","backend":"qbe"}' > "$stage/fern-package.json"
mv -f "$stage/fern-rs" bin/fern-rs
mv -f "$stage/fern" bin/fern
mv -f "$stage/fern-package.json" bin/fern-package.json
echo '✓ Built default Rust compiler: bin/fern (C reference: bin/fern-c)'
