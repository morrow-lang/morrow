#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/build-arguments"
[[ $# == 1 ]] || { echo "expected debug or release mode" >&2; exit 2; }
mode="$1"
case "$mode" in
  debug) build_configuration_words debug_flags; mode_flags=(${build_words[@]+"${build_words[@]}"}) ;;
  release) build_configuration_words release_flags; mode_flags=(${build_words[@]+"${build_words[@]}"}) ;;
  *) echo "Unknown build mode: $mode"; exit 1 ;;
esac
cc="$(/bin/bash scripts/build_config cc)"
build_configuration_words base_cflags; base=(${build_words[@]+"${build_words[@]}"})
build_configuration_words qbe_cflags; qbe=(${build_words[@]+"${build_words[@]}"})
build_configuration_words linenoise_cflags; linenoise=(${build_words[@]+"${build_words[@]}"})
mkdir -p build bin
src_objs=()
for src in $(/bin/bash scripts/build_config src_sources); do
  obj="build/$(basename "${src%.c}").o"
  "$cc" ${base[@]+"${base[@]}"} ${mode_flags[@]+"${mode_flags[@]}"} -c "$src" -o "$obj"
  src_objs+=("$obj")
done
lib_objs=()
for src in $(/bin/bash scripts/build_config lib_sources); do
  obj="build/lib_$(basename "${src%.c}").o"
  "$cc" ${base[@]+"${base[@]}"} ${mode_flags[@]+"${mode_flags[@]}"} -c "$src" -o "$obj"
  lib_objs+=("$obj")
done
qbe_objs=()
for src in $(/bin/bash scripts/build_config qbe_sources); do
  rel="${src#deps/qbe/}"
  rel_obj="${rel%.c}"
  rel_obj="${rel_obj//\//_}"
  obj="build/qbe_${rel_obj}.o"
  "$cc" ${qbe[@]+"${qbe[@]}"} -c "$src" -o "$obj"
  qbe_objs+=("$obj")
done
"$cc" ${linenoise[@]+"${linenoise[@]}"} -c deps/linenoise/linenoise.c -o build/linenoise.o
"$cc" ${base[@]+"${base[@]}"} ${mode_flags[@]+"${mode_flags[@]}"} -o bin/fern-c \
  ${src_objs[@]+"${src_objs[@]}"} ${lib_objs[@]+"${lib_objs[@]}"} ${qbe_objs[@]+"${qbe_objs[@]}"} build/linenoise.o -lm
echo "✓ Built C reference compiler: bin/fern-c"
