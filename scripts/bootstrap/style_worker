#!/bin/bash
# Native-supervised cache worker. Arguments are fixed literal paths, never shell fragments.
set -o pipefail
# The final checker inherits the supervisor's caller mask; only private build files use this mask.
umask 077
style_run= style_run_identity=
export LC_ALL=C
[[ $# == 4 ]] || exit 125
style_control=$1
style_root=$2
style_requested_cache=$3
style_tool_path=$4
export PATH=$style_tool_path
style_work=$style_control/payload
style_snapshot=$style_work/snapshot
style_scripts=$style_snapshot/scripts/bootstrap
for style_module in inputs cache collect publish cleanup flags; do
    source "$style_scripts/style_$style_module.sh" || exit 125
done
style_tools_init || exit 125
style_payload_identity=$(style_identity "$style_work") || exit 125
trap style_worker_exit EXIT
style_cache_root "$style_requested_cache" || exit 125
style_metadata_compile || exit 125
FERN_STYLE_CC=$style_cc FERN_STYLE_PKG_CONFIG=$style_pkg \
FERN_STYLE_AR=$style_ar FERN_STYLE_METADATA=$style_metadata \
/bin/bash "$style_snapshot/scripts/bootstrap/style_build" "$style_snapshot" || exit 125
style_collect "$style_snapshot" || exit 125
style_base_manifest "$style_work/final.base" || exit 125
/usr/bin/cmp -s "$style_work/base" "$style_work/final.base" || {
    style_retry_worker
    exit 125
}
style_publish || exit 125
style_prune || exit 125
style_handoff "$style_control" || exit 125
